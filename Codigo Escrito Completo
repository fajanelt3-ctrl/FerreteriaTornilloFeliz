Código fuente
Ferretería El Tornillo Feliz
El código está organizado en las tres capas del sistema y, dentro de cada una, por clase o formulario. Los archivos de diseño generados por Visual Studio (*.Designer.cs) no se incluyen, porque los controles se crean por código en el método CrearControles() de cada formulario.


1. Capa de Entidades
Clases que transportan datos entre las capas. No acceden a la base de datos.
1.1 Producto
Archivo: Entidades/Producto.cs. Artículo del inventario, con su alerta de stock mínimo.
namespace FerreteriaTornilloFeliz.Entidades
{
    /// <summary>
    /// Representa un producto del inventario de la ferretería.
    /// Es una entidad: solo guarda datos, no accede a la base de datos.
    /// </summary>
    public class Producto
    {
        public int Id { get; set; }
        public string Codigo { get; set; }
        public string Nombre { get; set; }
        public string Categoria { get; set; }
        public decimal PrecioCompra { get; set; }
        public decimal PrecioVenta { get; set; }
        public int Stock { get; set; }
        public int StockMinimo { get; set; }
        public bool Activo { get; set; }
 
        /// <summary>Constructor vacío: un producto nuevo nace activo.</summary>
        public Producto()
        {
            Activo = true;
        }
 
        /// <summary>Constructor completo, usado al leer un producto desde la base de datos.</summary>
        public Producto(int id, string codigo, string nombre, string categoria,
                        decimal precioCompra, decimal precioVenta,
                        int stock, int stockMinimo, bool activo)
        {
            Id = id;
            Codigo = codigo;
            Nombre = nombre;
            Categoria = categoria;
            PrecioCompra = precioCompra;
            PrecioVenta = precioVenta;
            Stock = stock;
            StockMinimo = stockMinimo;
            Activo = activo;
        }
 
        /// <summary>Verdadero cuando el stock está en el mínimo o por debajo (alerta de reabastecimiento).</summary>
        public bool BajoMinimo
        {
            get { return Stock <= StockMinimo; }
        }
    }
}
 

1.2 Venta
Archivo: Entidades/Venta.cs. Encabezado de la venta; contiene la lista de líneas y calcula el total.
using System;
using System.Collections.Generic;
 
namespace FerreteriaTornilloFeliz.Entidades
{
    /// <summary>
    /// Representa una venta con sus líneas de detalle (composición: una venta contiene
    /// uno o más DetalleVenta). Es una entidad: no accede a la base de datos.
    /// </summary>
    public class Venta
    {
        public int Id { get; set; }
        public DateTime Fecha { get; set; }
        public bool Anulada { get; set; }
        public decimal Total { get; set; }
 
        /// <summary>Líneas de la venta. Solo se modifican con AgregarDetalle y QuitarDetalle.</summary>
        public List<DetalleVenta> Detalles { get; private set; }
 
        public Venta()
        {
            Detalles = new List<DetalleVenta>();
            Fecha = DateTime.Now;
        }
 
        /// <summary>
        /// Agrega una línea. Si el producto ya está en la venta, suma la cantidad
        /// en lugar de crear una segunda línea.
        /// </summary>
        public void AgregarDetalle(DetalleVenta nuevo)
        {
            if (nuevo == null)
                throw new ArgumentNullException("nuevo");
 
            foreach (DetalleVenta existente in Detalles)
            {
                if (existente.IdProducto == nuevo.IdProducto)
                {
                    existente.Cantidad += nuevo.Cantidad;
                    return;
                }
            }
 
            Detalles.Add(nuevo);
        }
 
        /// <summary>Quita de la venta la línea de ese producto.</summary>
        public void QuitarDetalle(int idProducto)
        {
            Detalles.RemoveAll(d => d.IdProducto == idProducto);
        }
 
        /// <summary>Suma los subtotales de todas las líneas.</summary>
        public decimal CalcularTotal()
        {
            decimal total = 0;
            foreach (DetalleVenta d in Detalles)
                total += d.Subtotal;
            return total;
        }
    }
}
 

1.3 DetalleVenta
Archivo: Entidades/DetalleVenta.cs. Línea de una venta: producto, cantidad, precio y costo.
namespace FerreteriaTornilloFeliz.Entidades
{
    /// <summary>
    /// Una línea de una venta: un producto, su cantidad y los precios vigentes al momento de vender.
    /// Guarda también el costo unitario, para que los reportes de utilidad no cambien si
    /// después se modifica el precio de compra del producto.
    /// </summary>
    public class DetalleVenta
    {
        public int IdProducto { get; set; }
        public string CodigoProducto { get; set; }
        public string NombreProducto { get; set; }
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal CostoUnitario { get; set; }
 
        /// <summary>Importe de la línea: cantidad por precio unitario.</summary>
        public decimal Subtotal
        {
            get { return Cantidad * PrecioUnitario; }
        }
    }
}
 

