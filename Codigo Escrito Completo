            return new SqlConnection(cadena);
        }
    }
}
 

2.3 ProductoLN
Archivo: LogicaNegocios/ProductoLN.cs. Registro, edición, desactivación y búsqueda de productos.
using System;
using System.Collections.Generic;
using System.Data.SqlClient;
using FerreteriaTornilloFeliz.Entidades;
 
namespace FerreteriaTornilloFeliz.LogicaNegocios
{
    /// <summary>
    /// Lógica de negocio de los productos: valida las reglas y guarda/consulta en SQL Server.
    /// Todas las consultas usan parámetros (protección contra inyección SQL).
    /// </summary>
    public class ProductoLN
    {
        private const string Columnas =
            "Id, Codigo, Nombre, Categoria, PrecioCompra, PrecioVenta, Stock, StockMinimo, Activo";
 
        // ---------- Validaciones (reglas de negocio) ----------
 
        private static void Validar(Producto p)
        {
            if (p == null)
                throw new ReglaNegocioException("No se recibieron los datos del producto.");
 
            if (string.IsNullOrWhiteSpace(p.Codigo))
                throw new ReglaNegocioException("El código es obligatorio.");
            if (p.Codigo.Trim().Length > 20)
                throw new ReglaNegocioException("El código no puede tener más de 20 caracteres.");
 
            if (string.IsNullOrWhiteSpace(p.Nombre))
                throw new ReglaNegocioException("El nombre es obligatorio.");
            if (p.Nombre.Trim().Length > 100)
                throw new ReglaNegocioException("El nombre no puede tener más de 100 caracteres.");
 
            if (string.IsNullOrWhiteSpace(p.Categoria))
                throw new ReglaNegocioException("La categoría es obligatoria.");
            if (p.Categoria.Trim().Length > 50)
                throw new ReglaNegocioException("La categoría no puede tener más de 50 caracteres.");
 
            if (p.PrecioCompra < 0)
                throw new ReglaNegocioException("El precio de compra no puede ser negativo.");
            if (p.PrecioVenta <= 0)
                throw new ReglaNegocioException("El precio de venta debe ser mayor que cero.");
            if (p.PrecioCompra > 1000000 || p.PrecioVenta > 1000000)
                throw new ReglaNegocioException("Los precios no pueden superar Q1,000,000.");
            if (p.PrecioVenta < p.PrecioCompra)
                throw new ReglaNegocioException("El precio de venta no puede ser menor que el precio de compra.");
 
            if (p.Stock < 0)
                throw new ReglaNegocioException("El stock no puede ser negativo.");
            if (p.StockMinimo < 0)
                throw new ReglaNegocioException("El stock mínimo no puede ser negativo.");
        }
 
        // ---------- Operaciones de escritura ----------
 
        /// <summary>Registra un producto nuevo. Rechaza códigos repetidos.</summary>
        public void Registrar(Producto p)
        {
            Validar(p);
            string codigo = p.Codigo.Trim();
 
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            {
                cn.Open();
 
                if (ExisteCodigo(cn, codigo, 0))
                    throw new ReglaNegocioException(
                        "Ya existe un producto con el código " + codigo + " (puede estar desactivado).");
 
                const string sql =
                    "INSERT INTO Productos (Codigo, Nombre, Categoria, PrecioCompra, PrecioVenta, Stock, StockMinimo, Activo) " +
                    "VALUES (@codigo, @nombre, @categoria, @compra, @venta, @stock, @minimo, 1)";
 
                using (SqlCommand cmd = new SqlCommand(sql, cn))
                {
                    AsignarParametros(cmd, p);
                    cmd.ExecuteNonQuery();
                }
            }
        }
 
        /// <summary>Actualiza un producto existente. Rechaza códigos que ya usa otro producto.</summary>
        public void Actualizar(Producto p)
        {
            Validar(p);
            string codigo = p.Codigo.Trim();
 
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            {
                cn.Open();
 
                if (ExisteCodigo(cn, codigo, p.Id))
                    throw new ReglaNegocioException(
                        "Ya existe otro producto con el código " + codigo + " (puede estar desactivado).");
 
                const string sql =
                    "UPDATE Productos SET Codigo = @codigo, Nombre = @nombre, Categoria = @categoria, " +
                    "PrecioCompra = @compra, PrecioVenta = @venta, Stock = @stock, StockMinimo = @minimo " +
                    "WHERE Id = @id AND Activo = 1";
 
                using (SqlCommand cmd = new SqlCommand(sql, cn))
                {
                    AsignarParametros(cmd, p);
                    cmd.Parameters.AddWithValue("@id", p.Id);
 
                    if (cmd.ExecuteNonQuery() == 0)
                        throw new ReglaNegocioException("El producto ya no existe o fue desactivado.");
                }
            }
        }
 
        /// <summary>
        /// "Eliminar" un producto lo desactiva (Activo = 0). Así se conserva el historial de ventas
        /// y los reportes no pierden información.
        /// </summary>
        public void Desactivar(int id)
        {
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            {
                cn.Open();
                const string sql = "UPDATE Productos SET Activo = 0 WHERE Id = @id AND Activo = 1";
 
                using (SqlCommand cmd = new SqlCommand(sql, cn))
                {
                    cmd.Parameters.AddWithValue("@id", id);
 
                    if (cmd.ExecuteNonQuery() == 0)
                        throw new ReglaNegocioException("El producto ya no existe o ya estaba desactivado.");
                }
            }
        }
 
        // ---------- Consultas ----------
 
        /// <summary>Lista los productos activos, ordenados por nombre.</summary>
        public List<Producto> Listar()
        {
            return Consultar(
                "SELECT " + Columnas + " FROM Productos WHERE Activo = 1 ORDER BY Nombre", null);
        }
 
        /// <summary>Busca productos activos cuyo código o nombre contenga el texto.</summary>
        public List<Producto> Buscar(string texto)
        {
            if (string.IsNullOrWhiteSpace(texto))
                return Listar();
 
            return Consultar(
                "SELECT " + Columnas + " FROM Productos " +
                "WHERE Activo = 1 AND (Codigo LIKE @texto OR Nombre LIKE @texto) ORDER BY Nombre",
                "%" + texto.Trim() + "%");
        }
 
        /// <summary>Devuelve el producto activo con ese código exacto, o null si no existe.</summary>
        public Producto ObtenerPorCodigo(string codigo)
        {
            if (string.IsNullOrWhiteSpace(codigo))
                return null;
 
            List<Producto> lista = Consultar(
                "SELECT " + Columnas + " FROM Productos WHERE Activo = 1 AND Codigo = @texto",
                codigo.Trim());
 
            return lista.Count > 0 ? lista[0] : null;
        }
 
        /// <summary>Lista los productos activos con stock en el mínimo o por debajo (alertas).</summary>
        public List<Producto> ListarBajoMinimo()
        {
            return Consultar(
                "SELECT " + Columnas + " FROM Productos " +
                "WHERE Activo = 1 AND Stock <= StockMinimo ORDER BY Stock, Nombre", null);
        }
 
        // ---------- Métodos auxiliares privados ----------
 
        private static bool ExisteCodigo(SqlConnection cn, string codigo, int idExcluido)
        {
            const string sql = "SELECT COUNT(*) FROM Productos WHERE Codigo = @codigo AND Id <> @id";
 
            using (SqlCommand cmd = new SqlCommand(sql, cn))
            {
                cmd.Parameters.AddWithValue("@codigo", codigo);
                cmd.Parameters.AddWithValue("@id", idExcluido);
                return (int)cmd.ExecuteScalar() > 0;
            }
        }
 
        private static void AsignarParametros(SqlCommand cmd, Producto p)
        {
            cmd.Parameters.AddWithValue("@codigo", p.Codigo.Trim());
            cmd.Parameters.AddWithValue("@nombre", p.Nombre.Trim());
            cmd.Parameters.AddWithValue("@categoria", p.Categoria.Trim());
            cmd.Parameters.AddWithValue("@compra", Math.Round(p.PrecioCompra, 2));
            cmd.Parameters.AddWithValue("@venta", Math.Round(p.PrecioVenta, 2));
            cmd.Parameters.AddWithValue("@stock", p.Stock);
            cmd.Parameters.AddWithValue("@minimo", p.StockMinimo);
        }
 
        private static List<Producto> Consultar(string sql, string parametroTexto)
        {
            List<Producto> lista = new List<Producto>();
 
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            using (SqlCommand cmd = new SqlCommand(sql, cn))
            {
                if (parametroTexto != null)
                    cmd.Parameters.AddWithValue("@texto", parametroTexto);
 
                cn.Open();
                using (SqlDataReader dr = cmd.ExecuteReader())
                {
                    while (dr.Read())
                        lista.Add(Mapear(dr));
                }
            }
 
            return lista;
        }
 
        // El orden de las columnas coincide con la constante Columnas.
        private static Producto Mapear(SqlDataReader dr)
        {
            return new Producto(
                dr.GetInt32(0),     // Id
                dr.GetString(1),    // Codigo
                dr.GetString(2),    // Nombre
                dr.GetString(3),    // Categoria
                dr.GetDecimal(4),   // PrecioCompra
                dr.GetDecimal(5),   // PrecioVenta
                dr.GetInt32(6),     // Stock
                dr.GetInt32(7),     // StockMinimo
                dr.GetBoolean(8));  // Activo
        }
    }
}
 

2.4 VentaLN
Archivo: LogicaNegocios/VentaLN.cs. Registro de ventas en una transacción SQL y listado por fechas.
using System;
using System.Collections.Generic;
using System.Data.SqlClient;
using FerreteriaTornilloFeliz.Entidades;
 
namespace FerreteriaTornilloFeliz.LogicaNegocios
{
    /// <summary>
    /// Lógica de negocio de las ventas.
    /// RegistrarVenta es una operación atómica: guarda la venta, sus detalles y descuenta el stock
    /// dentro de UNA transacción SQL. Si cualquier paso falla, no se guarda nada (rollback).
    /// </summary>
    public class VentaLN
    {
        private const int CantidadMaximaPorLinea = 1000000;
 
        /// <summary>
        /// Registra la venta y devuelve su Id. La lógica NO confía en los precios que trae la pantalla:
        /// vuelve a leer precio, costo y stock reales desde SQL Server dentro de la transacción.
        /// </summary>
        public int RegistrarVenta(Venta venta)
        {
            if (venta == null)
                throw new ReglaNegocioException("No se recibieron los datos de la venta.");
            if (venta.Detalles.Count == 0)
                throw new ReglaNegocioException("La venta debe tener al menos un producto.");
 
            // 1. Consolidar cantidades por producto (por si un mismo producto llega en varias líneas).
            Dictionary<int, int> cantidades = new Dictionary<int, int>();
            foreach (DetalleVenta d in venta.Detalles)
            {
                if (d.Cantidad <= 0)
                    throw new ReglaNegocioException("La cantidad de cada producto debe ser mayor que cero.");
                if (d.Cantidad > CantidadMaximaPorLinea)
                    throw new ReglaNegocioException("La cantidad de un producto no puede superar " + CantidadMaximaPorLinea + ".");
 
                if (cantidades.ContainsKey(d.IdProducto))
                    cantidades[d.IdProducto] += d.Cantidad;
                else
                    cantidades.Add(d.IdProducto, d.Cantidad);
            }
 
            // 2. Ordenar por Id: todas las ventas bloquean los productos en el mismo orden,
            //    lo que evita interbloqueos (deadlocks) entre ventas simultáneas.
            List<int> ids = new List<int>(cantidades.Keys);
            ids.Sort();
 
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            {
                cn.Open();
 
                using (SqlTransaction tx = cn.BeginTransaction())
                {
                    try
                    {
                        // 3. Leer y bloquear cada producto, validando existencia, estado y stock.
                        List<DetalleVenta> lineas = new List<DetalleVenta>();
                        decimal total = 0;
 
                        foreach (int idProducto in ids)
                        {
                            DetalleVenta linea = LeerYBloquearProducto(cn, tx, idProducto, cantidades[idProducto]);
                            lineas.Add(linea);
                            total += linea.Subtotal;
                        }
 
                        // 4. Guardar la venta, sus detalles y descontar el stock.
                        int idVenta = InsertarVenta(cn, tx, total);
 
                        foreach (DetalleVenta linea in lineas)
                        {
                            InsertarDetalle(cn, tx, idVenta, linea);
                            DescontarStock(cn, tx, linea);
                        }
 
                        // 5. Todo salió bien: confirmar.
                        tx.Commit();
 
                        venta.Id = idVenta;
                        venta.Total = total;
                        return idVenta;
                    }
                    catch
                    {
                        try { tx.Rollback(); }
                        catch { /* si la conexión ya se perdió, SQL Server revierte por su cuenta */ }
                        throw;
                    }
                }
            }
        }
 
        /// <summary>
        /// Lista las ventas no anuladas entre dos fechas (inclusive), de la más reciente a la más antigua.
        /// Las ventas devueltas traen Id, Fecha y Total; sus detalles no se cargan.
        /// </summary>
        public List<Venta> ListarPorFechas(DateTime desde, DateTime hasta)
        {
            if (desde.Date > hasta.Date)
                throw new ReglaNegocioException("La fecha inicial no puede ser mayor que la fecha final.");
 
            List<Venta> lista = new List<Venta>();
 
            const string sql =
                "SELECT Id, Fecha, Total, Anulada FROM Ventas " +
                "WHERE Anulada = 0 AND Fecha >= @inicio AND Fecha < @fin " +
                "ORDER BY Fecha DESC, Id DESC";
 
            using (SqlConnection cn = ConexionBD.ObtenerConexion())
            using (SqlCommand cmd = new SqlCommand(sql, cn))
            {
                cmd.Parameters.AddWithValue("@inicio", desde.Date);
                cmd.Parameters.AddWithValue("@fin", hasta.Date.AddDays(1));
                cn.Open();
 
                using (SqlDataReader dr = cmd.ExecuteReader())
                {
                    while (dr.Read())
                    {
                        lista.Add(new Venta
                        {
                            Id = dr.GetInt32(0),
                            Fecha = dr.GetDateTime(1),
                            Total = dr.GetDecimal(2),
                            Anulada = dr.GetBoolean(3)
                        });
                    }
                }
            }
 
            return lista;
        }
 
        // ---------- Pasos de la transacción ----------
 
        // Lee el producto con UPDLOCK: nadie más puede cambiar su stock hasta que termine esta transacción.
        private static DetalleVenta LeerYBloquearProducto(SqlConnection cn, SqlTransaction tx, int idProducto, int cantidad)
        {
            const string sql =
                "SELECT Codigo, Nombre, PrecioCompra, PrecioVenta, Stock, Activo " +
                "FROM Productos WITH (UPDLOCK, ROWLOCK) WHERE Id = @id";
 
            using (SqlCommand cmd = new SqlCommand(sql, cn, tx))
            {
                cmd.Parameters.AddWithValue("@id", idProducto);
 
                using (SqlDataReader dr = cmd.ExecuteReader())
                {
                    if (!dr.Read())
                        throw new ReglaNegocioException("El producto con Id " + idProducto + " no existe.");
 
                    string codigo = dr.GetString(0);
                    string nombre = dr.GetString(1);
                    decimal precioCompra = dr.GetDecimal(2);
                    decimal precioVenta = dr.GetDecimal(3);
                    int stock = dr.GetInt32(4);
                    bool activo = dr.GetBoolean(5);
 
                    if (!activo)
                        throw new ReglaNegocioException(
                            "El producto \"" + nombre + "\" está desactivado y no se puede vender.");
 
                    if (cantidad > stock)
                        throw new ReglaNegocioException(
                            "Stock insuficiente de \"" + nombre + "\": disponible " + stock +
                            ", solicitado " + cantidad + ". No se registró la venta.");
 
                    return new DetalleVenta
                    {
                        IdProducto = idProducto,
                        CodigoProducto = codigo,
                        NombreProducto = nombre,
                        Cantidad = cantidad,
                        PrecioUnitario = precioVenta,
                        CostoUnitario = precioCompra
                    };
                }
            }
        }
 
        // Fecha y Anulada toman sus valores por defecto de la tabla (GETDATE() y 0).
        private static int InsertarVenta(SqlConnection cn, SqlTransaction tx, decimal total)
        {
            const string sql =
                "INSERT INTO Ventas (Total) VALUES (@total); " +
                "SELECT CAST(SCOPE_IDENTITY() AS INT);";
 
            using (SqlCommand cmd = new SqlCommand(sql, cn, tx))
            {
                cmd.Parameters.AddWithValue("@total", total);
                return (int)cmd.ExecuteScalar();
            }
        }
 
        private static void InsertarDetalle(SqlConnection cn, SqlTransaction tx, int idVenta, DetalleVenta linea)
        {
            const string sql =
                "INSERT INTO DetalleVenta (IdVenta, IdProducto, Cantidad, PrecioUnitario, CostoUnitario) " +
                "VALUES (@idVenta, @idProducto, @cantidad, @precio, @costo)";
 
            using (SqlCommand cmd = new SqlCommand(sql, cn, tx))
            {
                cmd.Parameters.AddWithValue("@idVenta", idVenta);
                cmd.Parameters.AddWithValue("@idProducto", linea.IdProducto);
                cmd.Parameters.AddWithValue("@cantidad", linea.Cantidad);
                cmd.Parameters.AddWithValue("@precio", linea.PrecioUnitario);
                cmd.Parameters.AddWithValue("@costo", linea.CostoUnitario);
                cmd.ExecuteNonQuery();
            }
        }
 
        // La condición "Stock >= @cantidad" es la última defensa: el stock nunca queda negativo.
        private static void DescontarStock(SqlConnection cn, SqlTransaction tx, DetalleVenta linea)
        {
            const string sql =
                "UPDATE Productos SET Stock = Stock - @cantidad " +
                "WHERE Id = @id AND Stock >= @cantidad";
 
            using (SqlCommand cmd = new SqlCommand(sql, cn, tx))
            {
                cmd.Parameters.AddWithValue("@cantidad", linea.Cantidad);
                cmd.Parameters.AddWithValue("@id", linea.IdProducto);
 
                if (cmd.ExecuteNonQuery() != 1)
                    throw new ReglaNegocioException(
                        "No se pudo descontar el stock de \"" + linea.NombreProducto +
                        "\" porque las existencias cambiaron. Intente de nuevo.");
            }
        }
    }
}
 

